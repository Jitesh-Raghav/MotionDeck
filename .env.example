# Copy to .env.local and fill in.

# Supabase project URL and server-side key (Project Settings → API).
# The service role / secret key must never be exposed to the browser.
# Without these, `npm run dev` saves signups to .data/waitlist.dev.json
# and production returns an error.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site, used for metadata, the OG image, robots and sitemap.
# On Vercel this falls back to the production domain automatically.
# Example: https://motiondeck.app
NEXT_PUBLIC_SITE_URL=
